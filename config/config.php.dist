<?php

// ----------------------------------------------------------------
//  -- إعدادات قاعدة البيانات --
// ----------------------------------------------------------------

// اسم مستضيف قاعدة البيانات (عادة localhost)
define('DB_HOST', 'localhost');

// اسم مستخدم قاعدة البيانات
define('DB_USER', 'root');

// كلمة مرور مستخدم قاعدة البيانات
define('DB_PASS', '');

// اسم قاعدة البيانات التي تريد نسخها احتياطياً
define('DB_NAME', 'my_database');


// ----------------------------------------------------------------
//  -- إعدادات النسخ الاحتياطي للملفات --
// ----------------------------------------------------------------

// المسارات الكاملة للمجلدات التي تريد نسخها
// يمكنك إضافة أكثر من مجلد
define('SOURCE_DIRECTORIES', [
    '/var/www/html/my_website',
    // '/var/www/html/another_website'
]);

// الأنماط التي سيتم استثناؤها من النسخ الاحتياطي (ملفات أو مجلدات)
// استخدم النجمة (*) كحرف بدل (wildcard)
define('EXCLUDE_PATTERNS', [
    'node_modules',
    '*.log',
    'cache/*',
    'tmp/*',
]);


// ----------------------------------------------------------------
//  -- إعدادات وجهة النسخ الاحتياطي --
// ----------------------------------------------------------------

// المسار الكامل للمجلد الذي سيتم حفظ النسخ الاحتياطية فيه
// تأكد من أن للسكربت صلاحيات الكتابة في هذا المجلد
define('BACKUP_DIR', __DIR__ . '/../backups');

// ----------------------------------------------------------------
//  -- إعدادات حذف النسخ القديمة (Rotation) --
// ----------------------------------------------------------------

// هل تريد تفعيل الحذف التلقائي للنسخ القديمة؟ (true or false)
define('DELETE_OLD_BACKUPS', true);

// عدد الأيام التي سيتم الاحتفاظ بالنسخ الاحتياطية قبل حذفها
define('KEEP_BACKUPS_FOR_DAYS', 7);


// ----------------------------------------------------------------
//  -- إعدادات ملف السجل (Logging) --
// ----------------------------------------------------------------

// المسار الكامل لملف السجل
define('LOG_FILE', __DIR__ . '/../logs/backup.log');

// ----------------------------------------------------------------
//  -- إعدادات الرفع عبر FTP (اختياري) --
// ----------------------------------------------------------------

// هل تريد تفعيل الرفع عبر FTP؟ (true or false)
define('FTP_ENABLED', false);

// اسم مستضيف الـ FTP
define('FTP_HOST', '');

// اسم مستخدم الـ FTP
define('FTP_USER', '');

// كلمة مرور مستخدم الـ FTP
define('FTP_PASS', '');

// المجلد البعيد على سيرفر الـ FTP الذي سيتم رفع النسخة إليه
define('FTP_DIR', '/backups');
